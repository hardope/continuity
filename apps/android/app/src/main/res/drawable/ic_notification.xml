<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFF">
    <!-- Same chain-link mark as ic_launcher.xml, scaled down with a
         relatively bolder stroke so the rings' holes stay legible at
         status-bar size. android:tint recolors whatever the path renders
         (stroke or fill), so the shape itself can stay black here. -->
    <group
        android:pivotX="7.6"
        android:pivotY="10"
        android:rotation="-25">
        <path
            android:pathData="M 3.6,7.6 H 11.6 A 2.4,2.4 0 0 1 11.6,12.4 H 3.6 A 2.4,2.4 0 0 1 3.6,7.6 Z"
            android:strokeColor="#FF000000"
            android:strokeWidth="2.1"
            android:fillColor="#00000000" />
    </group>
    <group
        android:pivotX="15.2"
        android:pivotY="13.6"
        android:rotation="65">
        <path
            android:pathData="M 11.2,11.2 H 19.2 A 2.4,2.4 0 0 1 19.2,16 H 11.2 A 2.4,2.4 0 0 1 11.2,11.2 Z"
            android:strokeColor="#FF000000"
            android:strokeWidth="2.1"
            android:fillColor="#00000000" />
    </group>
</vector>
